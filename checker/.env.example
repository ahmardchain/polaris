# The checker reads spike/.env for NEAR_ACCOUNT_ID, NEAR_PRIVATE_KEY, and EVM_CHAIN.
# Copy any overrides here. Do not commit secrets.

GUARANTEE_CONTRACT=guarantee.polaris-d1-z7npttup.testnet
# Separate from the owner. Created by `npm run set-checker`. Do not commit the key.
CHECKER_ACCOUNT=checker.polaris-d1-z7npttup.testnet
CHECKER_PRIVATE_KEY=ed25519:REPLACE_ME
# 0.2 NEAR paid to the agent if the payment is not proved before the deadline.
COVERAGE_YOCTO=200000000000000000000000
# Attached to fund_pool. 1 NEAR.
FUND_POOL_YOCTO=1000000000000000000000000
REQUIRED_CONFIRMATIONS=2
STUCK_AFTER_MS=24000
# Another MPC signature plus confirmations. If this does not fit before the deadline, do not bump.
RESCUE_BUDGET_MS=120000
