# Copy to spike/.env. Never commit spike/.env.

# NEAR testnet account that will request MPC signatures.
# Create one with: near create-account <name>.testnet --useFaucet
NEAR_ACCOUNT_ID=your-account.testnet

# Full-access private key. ed25519:... from the account's key file.
# This signs the NEAR transaction that calls v1.signer-prod.testnet. It is not the EVM key.
NEAR_PRIVATE_KEY=ed25519:REPLACE_ME

# Optional overrides.
NEAR_RPC_URL=https://rpc.testnet.near.org
MPC_CONTRACT_ID=v1.signer-prod.testnet
# The path selects the EVM key. It is not the destination chain.
# The address funded for the recorded Sepolia run uses this path; do not change it
# if you want to spend from 0x6Fed7c2dfCB2a08d36Cd1969c3107C0Be48BEDc6.
DERIVATION_PATH=polaris-base-sepolia

# Destination chain: base-sepolia (default) or ethereum-sepolia.
EVM_CHAIN=base-sepolia
# Optional RPC overrides. Base Sepolia still accepts BASE_SEPOLIA_RPC_URL and
# BASE_SEPOLIA_SEQUENCER_URL when EVM_CHAIN=base-sepolia.
# EVM_RPC_URL=https://sepolia.base.org
# EVM_SUBMIT_URL=https://sepolia-sequencer.base.org
# Ethereum Sepolia (chain id 11155111), where the Google Cloud faucet pays:
# EVM_CHAIN=ethereum-sepolia
# EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# EVM_SUBMIT_URL=https://ethereum-sepolia-rpc.publicnode.com

# 1 wei payment to the burn address. Override to pay a real recipient.
PAYMENT_TO=0x000000000000000000000000000000000000dEaD
PAYMENT_WEI=1

# Hard ceiling for the replacement transaction. The script refuses to sign above this.
# Default is 1 gwei (1000000000 wei).
FEE_CAP_WEI=1000000000

# Basis points added on top of the stuck fees. 1000 = 10%, Base's documented minimum bump.
REPLACEMENT_BUMP_BPS=1000

# How long to watch the underpriced hash before calling it stuck.
# Unset uses the chain default: 12000ms on Base (~2s blocks), 36000ms on Ethereum (~12s blocks).
# STUCK_WAIT_MS=36000
STUCK_POLL_MS=2000
RECEIPT_WAIT_MS=180000

# How long to wait for the MPC network to resume the NEAR yield.
MPC_WAIT_MS=180000
